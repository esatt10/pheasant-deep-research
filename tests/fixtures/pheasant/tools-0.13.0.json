    "memory_write": {
      "description": "Persist one agent-memory record (session/user/org scope) and index it.\n\n        The memory becomes retrievable via search_context immediately when\n        sync=true (read-your-writes). Requires a `type: memory` source.\n\n        principal records who asserted the memory; pass it whenever you know\n        the caller's identity, since it is what keeps one agent's memories\n        distinct from another's. kind marks a record as retrieval policy\n        (alias/preference/exclusion) instead of a fact. valid_until gives the\n        record an expiry it declares itself.\n\n        session identifies the conversation this call belongs to. It is\n        recorded, never enforced -- pass a stable opaque string and the\n        region can keep one refined memory per session; omit it and nothing\n        changes. Like principal, it is asserted by you and verified by\n        nobody.\n        ",
      "inputSchema": {
        "properties": {
          "kind": {
            "default": "fact",
            "title": "Kind",
            "type": "string"
          },
          "knowledge_base": {
            "title": "Knowledge Base",
            "type": "string"
          },
          "principal": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Principal"
          },
          "scope": {
            "default": "user",
            "title": "Scope",
            "type": "string"
          },
          "session": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Session"
          },
          "subject": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Subject"
          },
          "supersedes": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Supersedes"
          },
          "sync": {
            "default": true,
            "title": "Sync",
            "type": "boolean"
          },
          "tags": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
