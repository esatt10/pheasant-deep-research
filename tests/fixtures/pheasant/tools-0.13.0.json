                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Exclude"
          },
          "include": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Include"
          },
          "knowledge_base": {
            "title": "Knowledge Base",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "path": {
            "default": "",
            "title": "Path",
            "type": "string"
          },
          "source_type": {
            "title": "Source Type",
            "type": "string"
          },
          "sync_mode": {
            "default": "incremental",
            "title": "Sync Mode",
            "type": "string"
          },
          "sync_now": {
            "default": false,
            "title": "Sync Now",
            "type": "boolean"
          },
          "taxonomy": {
