    "search_context_batch": {
      "description": "Search for many queries in one call and return one merged context.\n\n        Use this instead of calling search_context repeatedly when you need\n        context for several sub-questions, facets or identifiers at once. Up\n        to 25 queries, and at most 1000 hits in total (queries x max_results).\n        Every other argument means what it means on search_context and applies\n        to every query.\n\n        results is the merged context: each passage once, ordered by rank\n        across queries -- every query's best hit, then every query's second --\n        so truncating it keeps coverage of every query. Each hit's \"batch\"\n        block lists the query indexes that found it. searches holds each\n        query's own result set unless per_query is false; counts.overlap is\n        how many hits a query shared with an earlier one.\n        ",
      "inputSchema": {
        "properties": {
          "as_of": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "As Of"
          },
          "exclude_source_types": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Exclude Source Types"
          },
          "exclude_sources": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Exclude Sources"
          },
          "knowledge_base": {
            "title": "Knowledge Base",
            "type": "string"
          },
          "max_results": {
            "default": 10,
            "title": "Max Results",
            "type": "integer"
          },
          "memory": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Memory"
          },
          "min_score": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Min Score"
          },
          "mode": {
