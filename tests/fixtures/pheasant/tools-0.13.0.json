    "seal_snapshot": {
      "description": "Seal the current state as a run's reference snapshot.\n\n        Idempotent over an unchanged region: the id is a digest of the state.\n        Pin a search to the returned `snapshot_id` and this region will answer\n        from that state or refuse \u2014 it does not hold older corpus versions, so\n        the guarantee is that two runs naming one snapshot cannot silently have\n        seen different corpora.\n        ",
      "inputSchema": {
        "properties": {
          "knowledge_base": {
            "title": "Knowledge Base",
            "type": "string"
          },
